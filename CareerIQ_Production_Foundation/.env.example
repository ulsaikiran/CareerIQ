# Local development defaults. Never commit actual secrets.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=careeriq.db
UPLOAD_DIR=private_uploads
COOKIE_SECURE=0
FLASK_DEBUG=0

# Optional Google Cloud certificate object storage. Bucket must be private and
# the runtime service account should have only object-level permissions needed.
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Optional Vertex AI roadmap guidance (rule-based guidance remains the fallback).
VERTEX_AI_ENABLED=0
VERTEX_AI_LOCATION=asia-south1
VERTEX_AI_MODEL=gemini-2.5-flash

# Optional SMTP notifications; use a provider credential stored in Secret Manager.
PUBLIC_BASE_URL=http://127.0.0.1:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Admin is a dedicated, secured existing account email configured out-of-band.
CAREERIQ_ADMIN_EMAIL=

# Authorized job-feed adapter: POST normalized jobs JSON to /integrations/job-feed.
JOB_FEED_TOKEN=
JOB_FEED_COMPANY_EMAIL=

# Production is still blocked until Cloud SQL/PostgreSQL is integrated and tested.
